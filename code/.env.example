# =============================================================================
# PROCESSOR API KEYS AND CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual API keys and endpoints

# -----------------------------------------------------------------------------
# OpenRouter API (for various LLM models)
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback OpenAI key (needed for gpt-5)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL="https://api.openai.com/v1"

# -----------------------------------------------------------------------------
# Azure Document Intelligence
# -----------------------------------------------------------------------------
# Get credentials from: https://portal.azure.com/
AZURE_KEY=your_azure_document_intelligence_key_here
AZURE_URL=https://your-resource-name.cognitiveservices.azure.com/

# -----------------------------------------------------------------------------
# Mathpix OCR (LaTeX and mathematical formula support)
# -----------------------------------------------------------------------------
# Get credentials from: https://mathpix.com/
MATHPIX_APP_ID=your_mathpix_app_id_here
MATHPIX_APP_KEY=your_mathpix_app_key_here

# -----------------------------------------------------------------------------
# Mistral OCR
# -----------------------------------------------------------------------------
# Get API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# -----------------------------------------------------------------------------
# Amazon Textract (AWS)
# -----------------------------------------------------------------------------
# Get credentials from AWS Console: https://console.aws.amazon.com/
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=

# -----------------------------------------------------------------------------
# Unstructured.io API
# -----------------------------------------------------------------------------
# Get API key from: https://unstructured.io/
UNSTRUCTURED_API_KEY=your_unstructured_api_key_here

# -----------------------------------------------------------------------------
# Chunkr API
# -----------------------------------------------------------------------------
# Get API key from: https://chunkr.ai/
CHUNKR_API_KEY=your_chunkr_api_key_here
